FROM nginx:1.27-alpine

RUN rm -f /etc/nginx/conf.d/default.conf \
    && sed -i 's/^worker_processes .*/worker_processes 2;/' /etc/nginx/nginx.conf

# ATLASSIAN_MCP_AUTH: full Authorization header value, e.g.
# "Basic <base64(email:api_token)>". Injected at container start by the nginx
# entrypoint (envsubst); empty means requests go upstream unauthenticated.
ENV ATLASSIAN_MCP_AUTH=""

RUN mkdir -p /etc/nginx/templates \
    && cat > /etc/nginx/templates/default.conf.template <<'EOF'
server {
    listen 8080;
    server_name _;

    resolver 223.5.5.5 valid=30s;
    client_max_body_size 16m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Path passthrough: clients use /v2/mcp (or /v1/mcp) exactly as with the
    # hosted server. The upstream credential is injected here so callers only
    # need network access to this Service.
    location / {
        set $backend "mcp.atlassian.com";
        proxy_pass https://$backend;
        proxy_set_header Host $backend;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization "${ATLASSIAN_MCP_AUTH}";
        proxy_ssl_server_name on;
        proxy_ssl_name $backend;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
EOF

EXPOSE 8080

# Runs as root by default and needs CAP_CHOWN/CAP_SETUID/CAP_SETGID at startup;
# keep them when dropping capabilities via securityContext.
