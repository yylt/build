diff --git a/external/extensions/custom-extension.sh b/external/extensions/custom-extension.sh
new file mode 100755
index 0000000..c26a0dc
--- /dev/null
+++ b/external/extensions/custom-extension.sh
@@ -0,0 +1,68 @@
+#!/usr/bin/env bash
+#
+# Extension Name: custom patch
+# Description: Adds patch support for Orange Pi 5 Pro
+# Author: Orange Pi Build System
+# Dependencies: None
+# Supported Boards: orangepi5pro
+# Supported Branches: current
+#
+
+# Extension configuration
+PATCH_FILE=(
+	"${EXTER}/patch/kernel/0000-log-bcmdhd.patch"
+	"${EXTER}/patch/kernel/0002-log-fuxi.patch"
+)
+
+custom_extension_apply_patch_file() {
+	local patch_file="$1"
+	pushd "${kerneldir}" >/dev/null || exit_with_error ""Custom Extension" couldn't enter kerneldir" "${kerneldir}"
+	if patch --forward --strip=1 --input="${patch_file}" --silent; then
+		display_alert ""Custom Extension"" "Applied patch $(basename "${patch_file}")" "info"
+	else
+		local status=$?
+		if [[ ${status} -eq 1 ]]; then
+			display_alert ""Custom Extension"" "Patch already applied: $(basename "${patch_file}")" "wrn"
+		else
+			popd >/dev/null
+			exit_with_error ""Custom Extension" patch failed" "${patch_file}"
+		fi
+	fi
+	popd >/dev/null
+}
+
+custom_extension_normalize_line_endings() {
+	local target_dir="$1"
+
+	if [[ -z "${target_dir}" || ! -d "${target_dir}" ]]; then
+		return
+	fi
+
+	python3 - <<'PY' "${target_dir}"
+import pathlib
+import sys
+
+root = pathlib.Path(sys.argv[1])
+for path in root.rglob('*'):
+    if not path.is_file():
+        continue
+    data = path.read_bytes()
+    if b'\r' not in data:
+        continue
+    new_data = data.replace(b'\r\n', b'\n')
+    if new_data != data:
+        path.write_bytes(new_data)
+PY
+}
+
+# Hook: Install before kernel configuration
+custom_kernel_config__install_custom_extension() {
+	# Apply patches
+	for patch_file in "${PATCH_FILE[@]}"; do
+		if [[ -f "${patch_file}" ]]; then
+			custom_extension_apply_patch_file "${patch_file}"
+		else
+			display_alert "Custom Extension" "Patch file not found: ${patch_file}" "wrn"
+		fi
+	done
+}
